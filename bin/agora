#!/usr/bin/env bash

# AgoraUI CLI Tool
# Command-line interface for AgoraUI project management

set -e

# Get the directory where this script is located (resolving symlinks)
# This is critical for npm link to work correctly
SCRIPT_FILE="$0"
if [ -L "$SCRIPT_FILE" ]; then
    # If this script is a symlink (from npm link), resolve it
    readonly SCRIPT_PATH="$(readlink -f "$SCRIPT_FILE")"
    readonly SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
else
    # Direct execution
    readonly SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_FILE")" && pwd)"
fi
readonly PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
readonly CONF_DIR="$PROJECT_ROOT/conf"
readonly CLI_MODULES_DIR="$SCRIPT_DIR/commands"

# Colors for output
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly BLUE='\033[0;34m'
readonly YELLOW='\033[1;33m'
readonly NC='\033[0m' # No Color
readonly BOLD='\033[1m'

# Version
readonly VERSION="2.0.0"

# Show banner
show_banner() {
    echo -e "${BLUE}${BOLD}"
    echo "    _                           _   _ ___ "
    echo "   / \   __ _  ___  _ __ __ _  | | | |_ _|"
    echo "  / _ \ / _\` |/ _ \| '__/ _\` | | | | || | "
    echo " / ___ \ (_| | (_) | | | (_| | | |_| || | "
    echo "/_/   \_\__, |\___/|_|  \__,_|  \___/|___|"
    echo "        |___/                              "
    echo -e "${NC}"
    echo -e "Version ${VERSION}\n"
}

# Show help
show_help() {
    show_banner
    echo -e "${BOLD}Usage:${NC} agora <command> [options]\n"
    echo -e "${BOLD}Commands:${NC}"
    echo -e "  ${GREEN}init${NC}              Run interactive configuration wizard"
    echo -e "  ${GREEN}default${NC}           Restore default AgoraUI configuration"
    echo -e "  ${GREEN}serve${NC}             Start development server"
    echo -e "  ${GREEN}build${NC}             Build the application for production"
    echo -e "  ${GREEN}test${NC}              Run unit tests"
    echo -e "  ${GREEN}lint${NC}              Run linter"
    echo -e "  ${GREEN}backend:start${NC}     Start backend services (Docker)"
    echo -e "  ${GREEN}backend:stop${NC}      Stop backend services"
    echo -e "  ${GREEN}backend:logs${NC}      Show backend service logs"
    echo -e "  ${GREEN}version${NC}           Show AgoraUI CLI version"
    echo -e "  ${GREEN}help${NC}              Show this help message\n"
    echo -e "${BOLD}Options:${NC}"
    echo -e "  ${YELLOW}-h, --help${NC}        Show help for command"
    echo -e "  ${YELLOW}-v, --version${NC}     Show version\n"
    echo -e "${BOLD}Examples:${NC}"
    echo -e "  agora init                    # Configure the application"
    echo -e "  agora default                 # Restore default settings"
    echo -e "  agora serve                   # Start dev server"
    echo -e "  agora build                   # Build for production"
    echo -e "  agora backend:start           # Start all backend services\n"
}

# Show version
show_version() {
    echo "AgoraUI CLI v${VERSION}"
}

# Execute npm script
run_npm_script() {
    local script=$1
    shift
    
    # Verify PROJECT_ROOT exists
    if [ ! -d "$PROJECT_ROOT" ]; then
        echo -e "${RED}Error: Project root not found: $PROJECT_ROOT${NC}"
        exit 1
    fi
    
    # Verify package.json exists
    if [ ! -f "$PROJECT_ROOT/package.json" ]; then
        echo -e "${RED}Error: package.json not found in: $PROJECT_ROOT${NC}"
        exit 1
    fi
    
    # Change to project root and run npm
    echo -e "${BLUE}Running:${NC} npm run $script $@"
    (cd "$PROJECT_ROOT" && npm run "$script" "$@")
}

# Command handlers
cmd_init() {
    echo -e "${BLUE}Starting AgoraUI configuration wizard...${NC}\n"
    AGORA_CLI=1 bash "$CONF_DIR/setup.sh"
}

cmd_default() {
    echo -e "${BLUE}Restoring AgoraUI default configuration...${NC}\n"
    AGORA_CLI=1 bash "$CONF_DIR/default.sh"
}

cmd_serve() {
    run_npm_script "start" "$@"
}

cmd_build() {
    run_npm_script "build" "$@"
}

cmd_test() {
    run_npm_script "test" "$@"
}

cmd_lint() {
    run_npm_script "lint" "$@"
}

cmd_backend_start() {
    echo -e "${BLUE}Starting backend services...${NC}"
    run_npm_script "backend:start"
}

cmd_backend_stop() {
    echo -e "${BLUE}Stopping backend services...${NC}"
    run_npm_script "backend:stop"
}

cmd_backend_logs() {
    if [ -z "$1" ]; then
        echo -e "${BLUE}Showing logs for all services...${NC}"
        (cd "$PROJECT_ROOT" && docker compose logs -f)
    else
        echo -e "${BLUE}Showing logs for $1...${NC}"
        (cd "$PROJECT_ROOT" && docker compose logs -f "$1")
    fi
}

# Main command router
main() {
    # Handle no arguments
    if [ $# -eq 0 ]; then
        show_help
        exit 0
    fi
    
    # Parse command
    local command=$1
    shift
    
    case "$command" in
        init)
            cmd_init "$@"
            ;;
        default|reset)
            cmd_default "$@"
            ;;
        serve|start|s)
            cmd_serve "$@"
            ;;
        build|b)
            cmd_build "$@"
            ;;
        test|t)
            cmd_test "$@"
            ;;
        lint|l)
            cmd_lint "$@"
            ;;
        backend:start|bs)
            cmd_backend_start "$@"
            ;;
        backend:stop|bst)
            cmd_backend_stop "$@"
            ;;
        backend:logs|bl)
            cmd_backend_logs "$@"
            ;;
        version|-v|--version)
            show_version
            ;;
        help|-h|--help)
            show_help
            ;;
        *)
            echo -e "${RED}Error: Unknown command '${command}'${NC}\n"
            show_help
            exit 1
            ;;
    esac
}

# Run main function
main "$@"
